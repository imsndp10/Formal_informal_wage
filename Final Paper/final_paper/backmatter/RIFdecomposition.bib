@Article{Firpo2009,
  author       = {Sergio Firpo and Nicole M. Fortin and Thomas Lemieux},
  date         = {2009},
  journaltitle = {Econometrica},
  title        = {Unconditional Quantile Regressions},
  issn         = {00129682, 14680262},
