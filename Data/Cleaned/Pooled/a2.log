. do "/var/folders/14/04v4h4t52rq0_5mkppfg4bp40000gn/T//SD05543.000000"

. putexcel set test2.xlsx, sheet(xyz) replace

. 
. * Loop through quantiles and perform Oaxaca-RIF decomposition
. local row = 1

. foreach q of local quantiles {
  2.     * Perform Oaxaca-RIF decomposition and save results using putexcel
.     oaxaca_rif ln_wage $exp $education $caste hh_size female ///
>     married child_12 voc_train migrated_fr_job tot_chores_hrs urban overtime_40 ///
>     if year == 2008 , by(formal_employment) wgt(1) rif(q(`q')) rwlogit(HH_formal dep_ratio $exp $education $caste) swap
  3.     
.     * Save the results to the Excel sheet
.     matrix results = r(table)'
  4.     
.     * Save the quantile label
.     putexcel A`row' = ("Quantile `q'")
  5.     
.     * Save the matrix results starting from the next row
.     local next_row = `row' + 1
  6.     putexcel A`next_row' = matrix(results)
  7.     
.     * Update row counter for the next quantile block
.     local row = `row' + rowsof(results) + 2
  8. }

. 
end of do-file

