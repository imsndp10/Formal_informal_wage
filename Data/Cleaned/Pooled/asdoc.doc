{\b\qc\line  }{\par}
\fs20 {Estimating Reweighted RIF-OAXACA using RIF:q(65)}\line
\fs20 {Model  : Blinder-Oaxaca RIF-decomposition}\line
\fs20 {Type   : Reweighted}\line
\fs20 {RIF    : q(65)}\line
\fs20 {Scale  : 1}\line
